# Test results
TestResults/
*.trx
coverage/
coveragereport/
StrykerOutput/
*.coverage
*.coveragexml

# L3 harness ephemeral context (regenerated by start-task.py)
.harness/context/

# L3 dispatcher runtime state (RUNS.jsonl + task worktrees, regenerated)
.harness/runs/
.harness/worktrees/
.harness/**/__pycache__/

# L5 human verification records (generated by verify-all.py, kept locally only)
# docs/verification/VERIFY-TEMPLATE.md 是模板（应入仓），VERIFY-*.md 是产物（不入仓）。
docs/verification/VERIFY-*.md

# NuGet
packages/
*.nupkg
project.lock.json

# Code analysis
_Resharper*/
_ReSharper*/
*.dotCover

# 反编译工具与中间产物（不入仓，仅本地保留）
.tools/
ghidra-projects/
.decomp/
*_ghidra/
*.rep/
*.gbf

# 设备二进制目录（不入仓，仅本地保留）
CNC/
CNC04/
DHH02/
DHH04/
MZS01/

# transient root dirs (session scratch, pending architect disposition)
.ci-fix-patch-TMP/

# python caches everywhere
**/__pycache__/
