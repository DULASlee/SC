{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "timer"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "timer": { "type": "integer", "minimum": 1, "default": 20 },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
