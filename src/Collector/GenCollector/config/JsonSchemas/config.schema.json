{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "mqtt"],

  /*
   * Schema Version: 1.0.0
   * Version Migration Chain:
   *   1.0.0 -> (future: 1.1.0) -> (future: 2.0.0)
   * Compatibility Strategy:
   *   - Minor version increments (1.0.0 -> 1.1.0): additive fields, backward-compatible
   *   - Major version increments (1.x -> 2.0): breaking changes require migration tooling
   *   - When upgrading: validate against target schema version before applying
   *   - When downgrading: strip unknown fields not present in target version
   */
  "schemaVersion": "1.0.0",
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "appId": { "type": "string", "minLength": 1 },
    "mqtt": {
      "type": "object",
      "required": ["server", "prefix"],
      "properties": {
        "server": { "type": "string" },
        "prefix": { "type": "string" },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 },
        "reconnect": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "initialDelayMs": { "type": "integer", "minimum": 100, "default": 1000 },
            "maxDelayMs": { "type": "integer", "minimum": 1000, "default": 60000 },
            "multiplier": { "type": "number", "minimum": 1.0, "default": 2.0 }
          }
        }
      }
    },
    "simulate": { "type": "boolean", "default": false },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8080 },
    "authCode": { "type": "string", "default": "" },
    "database": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "type": { "type": "string", "enum": ["iotdb", "mysql", "postgresql", "sqlite"], "default": "iotdb" }
      }
    },
    "ditto": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "endpoint": { "type": "string" },
        "namespace": { "type": "string", "default": "org.gencore" }
      }
    },
    "andons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "devices"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "devices": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
