#!/bin/bash
# L0-L3 local gates: all must pass before commit
# Architect §1 plan 1 (pre-commit hook)
# TASK-024 C2/C4: 受保护路径判定唯一入口 = commit-msg hook + check_approval.py；
#   check-protected-paths.py 调用已移除（全仓零 live 引用证据见
#   docs/testing/red/TASK-024/scan-report.md）；教育提示统一为现行模型，
#   输出 ASCII 化（AGENTS 规则 4）。
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# shellcheck disable=SC1091
source .githooks/lib/common.sh

echo "=== pre-commit gate ==="

# 0. L0 session registration gate (TASK-042): worktree commits require an
#    active start-session registration; main-tree commits pass through.
#    ASCII output (AGENTS rule 4). No bypass by design.
python docs/ai-workspace/hooks/check_session_registration.py || fail "worktree commit not bound to a registered session (run .harness/scripts/start-session.py TASK-XXX)"

# 1. Task card validation
python .harness/scripts/validate-task-card.py --all || fail "task card validation failed"

# 2. Local scope check (allow_write / deny_write / scale, per active card)
python .harness/scripts/check-local-scope.py || fail "scope check failed"

# 3. Contract consistency
python scripts/check-contract-consistency.py || fail "contract consistency failed"

# 4. Build with warnings-as-errors
# 注：本仓库无 .sln 文件，逐个工程 build。
# 用 bash 数组传参（避免行末 \ 续行吞参数）。
PROJECTS=(
    "src/Collector/GenCollector/GenCollector.csproj"
    "src/Frontend/GenDashboard/GenDashboard.csproj"
    "tests/GenCollector.Tests/GenCollector.Tests.csproj"
    "tests/GenDashboard.Tests/GenDashboard.Tests.csproj"
    "tests/ReliabilityTests/ReliabilityTests.csproj"
    "src/Backend/IoTPlatform.Core/IoTPlatform.Core.csproj"
    "src/Backend/IoTPlatform.Adapters/IoTPlatform.Adapters.csproj"
    "src/Backend/IoTPlatform.Host/IoTPlatform.Host.csproj"
    "src/Frontend/IoTPlatform.UI.Wpf/IoTPlatform.UI.Wpf.csproj"
)
for proj in "${PROJECTS[@]}"; do
    [ -f "$proj" ] || continue
    if [[ "$proj" == *GenCollector* ]]; then
        args=( "$proj" -c Release -r win-x86 --self-contained true "-p:PlatformTarget=x86" "-p:TreatWarningsAsErrors=true" --nologo -v quiet )
    else
        args=( "$proj" -c Release "-p:TreatWarningsAsErrors=true" --nologo -v quiet )
    fi
    dotnet build "${args[@]}" || fail "build failed: $proj"
done

# 5. Architecture tests (if present)
if [ -f "tests/ArchitectureTests/ArchitectureTests.csproj" ]; then
    dotnet test tests/ArchitectureTests/ArchitectureTests.csproj -c Release --no-build --nologo -v quiet || fail "architecture tests failed"
else
    info "ArchitectureTests not present, skipping (out of this phase)"
fi

ok "pre-commit all passed"

# 教育性提示：在 hook 失败时打印（通过 set -e 触发 EXIT trap）
# TASK-024 C2：提示统一反映现行模型（TASK 引用 + 覆盖卡 approver + SKIP 通道），
#   [APPROVED-BY] 与豁免前缀（chore:/docs:）旧语义已随 023 E1 移除作废。
on_error() {
    local exit_code=$?
    echo "" >&2
    cat <<'EOF' >&2

===========================================================================
pre-commit gate fix guide (current model, TASK-024 C2)
===========================================================================
- task card validation failed -> fix .harness/tasks/active/TASK-XXX.yaml
- scope check failed         -> limit changes to the active card allow_write,
                                or open a new task card
- contract consistency failed -> check contracts/openapi.yaml vs .harness/schema/
- build failed               -> fix CS/RS/RCS warnings per .editorconfig
- protected paths (.harness/**, tests/**, contracts/**, .githooks/**,
  .github/**, Directory.Build.props/targets, stryker-config.json):
  the commit-msg hook enforces via check_approval.py:
    (1) commit message first line must reference TASK-XXX
    (2) an active card (status ready/in-progress) whose allow_write covers
        the file AND with a non-empty approver field, or
    (3) architect sets SKIP_PROTECTED_CHECK=1 (architect channel only)
===========================================================================
EOF
}
trap on_error ERR
