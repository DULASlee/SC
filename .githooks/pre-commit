#!/bin/bash
# L0-L3 本地门禁：提交前必须全部通过
# 架构师 §一 方案 1（pre-commit hook）
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# shellcheck disable=SC1091
source .githooks/lib/common.sh

echo "=== pre-commit 门禁 ==="

# 1. 关键目录保护
python .harness/scripts/check-protected-paths.py || fail "关键目录越权修改"

# 2. 任务卡校验
python .harness/scripts/validate-task-card.py --all || fail "任务卡校验失败"

# 3. 本地 scope 检查
python .harness/scripts/check-local-scope.py || fail "scope 检查失败"

# 4. 契约一致性
python scripts/check-contract-consistency.py || fail "契约一致性失败"

# 5. 编译 + 警告即错误
# 注：本仓库无 .sln 文件，逐个工程 build。
#     用 bash 数组传参（避免行末 \ 续行吞参数）。
PROJECTS=(
    "GenCollector/GenCollector.csproj"
    "GenDashboard/GenDashboard.csproj"
    "GenCollector.Tests/GenCollector.Tests.csproj"
    "GenDashboard.Tests/GenDashboard.Tests.csproj"
    "source/IoTPlatform/src/IoTPlatform.Core/IoTPlatform.Core.csproj"
    "source/IoTPlatform/src/IoTPlatform.Adapters/IoTPlatform.Adapters.csproj"
    "source/IoTPlatform/src/IoTPlatform.Host/IoTPlatform.Host.csproj"
    "source/IoTPlatform/samples/IoTPlatform.UI.Wpf/IoTPlatform.UI.Wpf.csproj"
)
for proj in "${PROJECTS[@]}"; do
    [ -f "$proj" ] || continue
    if [[ "$proj" == GenCollector* ]]; then
        args=( "$proj" -c Release -r win-x86 --self-contained true "-p:PlatformTarget=x86" "-p:TreatWarningsAsErrors=true" --nologo -v quiet )
    else
        args=( "$proj" -c Release "-p:TreatWarningsAsErrors=true" --nologo -v quiet )
    fi
    dotnet build "${args[@]}" || fail "编译失败：$proj"
done

# 6. 架构测试（如果存在）
if [ -f "tests/ArchitectureTests/ArchitectureTests.csproj" ]; then
    dotnet test tests/ArchitectureTests/ArchitectureTests.csproj -c Release --no-build --nologo -v quiet || fail "架构测试失败"
else
    info "ArchitectureTests 不存在，跳过（不在本阶段范围）"
fi

ok "pre-commit 全部通过"

# 教育性提示：在 hook 失败时打印（通过 set -e 触发 EXIT trap）
# 注：trap 在 set -e 下，每个失败命令会触发 EXIT 一次，但 bash 默认 EXIT trap 只触发一次
# 用 on_error 函数在 ERR trap 上调用
on_error() {
    local exit_code=$?
    echo "" >&2
    cat <<'EOF' >&2

=========================================================================
pre-commit 门禁失败修复指南
=========================================================================
- 任务卡校验失败  → 修改 .harness/tasks/active/TASK-XXX.yaml
- scope 检查失败  → 将变更限制在 allow_write 范围内，或申请新任务卡
- 契约一致性失败  → 检查 contracts/openapi.yaml 与 .harness/schema/ 一致性
- 编译失败       → 按 .editorconfig 修复 CS/RS/RCS 警告
- 受保护路径     → commit message 加 [APPROVED-BY: 架构师-name]
- 受保护路径     → 或用豁免前缀（chore:/docs:） + commit message 含 type(scope)
=========================================================================
EOF
}
trap on_error ERR
