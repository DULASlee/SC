#!/bin/bash
# 重量门禁：推送前必须全部通过
# 架构师 §一 方案 1（pre-push hook）
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# shellcheck disable=SC1091
source .githooks/lib/common.sh

echo "=== pre-push 门禁 ==="

# 1. 全测试（仓库无 .sln，逐个工程）
for proj in GenCollector.Tests/GenCollector.Tests.csproj GenDashboard.Tests/GenDashboard.Tests.csproj tests/ReliabilityTests/ReliabilityTests.csproj; do
    if [ -f "$proj" ]; then
        if [[ "$proj" == GenCollector* ]]; then
            dotnet test "$proj" -c Release -p:PlatformTarget=x86 --no-build --nologo -v quiet \
                || fail "全测试失败：$proj"
        else
            dotnet test "$proj" -c Release --no-build --nologo -v quiet \
                || fail "全测试失败：$proj"
        fi
    fi
done

# 2. 覆盖率差分（如果存在脚本）
if [ -f "scripts/check-coverage-diff.sh" ]; then
    bash scripts/check-coverage-diff.sh || warn "覆盖率差分未通过（观察期）"
else
    info "coverage-diff 脚本不存在，跳过（L2-B partial 阶段未启用）"
fi

# 3. 变异测试（如果配置存在）
if [ -f "stryker-config.json" ]; then
    info "变异测试为观察期，跳过阻断（L2-B 阶段，break=15）"
else
    info "stryker-config.json 不存在，跳过变异测试"
fi

# 4. 可靠性工具链（仅在 Docker daemon 可用时跑）
if command -v docker > /dev/null 2>&1 && docker info > /dev/null 2>&1; then
    info "检测到 Docker daemon，运行可靠性工具链"
    dotnet test tests/ReliabilityTests/ReliabilityTests.csproj -c Release --nologo -v quiet \
        || warn "可靠性工具链未通过（观察期）"
else
    info "本地无 Docker daemon，跳过 ReliabilityTests（架构师 §五 允许降级）"
fi

ok "pre-push 全部通过"
