#!/bin/bash
# 强制 commit message 引用 TASK-XXX（架构师 §一 S4）
set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 豁免前缀（配置类、文档类、harness 自身提交）
EXEMPT_PREFIXES=(
    "chore:"
    "docs:"
    "fix(ci):"
    "feat(l0):"
    "feat(l1"
    "feat(l2"
    "feat(l3"
    "feat(l4"
    "feat(local-ci"
)

FIRST_LINE="$(echo "$COMMIT_MSG" | head -n 1)"

for prefix in "${EXEMPT_PREFIXES[@]}"; do
    # 豁免匹配：commit message 类型 type 字段含豁免前缀关键字（如 "chore" 或 "docs"）即可。
    # 原架构师设计是精确前缀（如 "chore:"），但 commit 格式常为 "chore(scope): ..."
    # 用 "type(scope):" 的 type 段作匹配，更宽松且兼容。
    type_word="${prefix%:}"  # 去掉冒号
    # 提取 type_word（首段字母数字），匹配 "type_word(" 或 "type_word:" 或纯 "type_word"
    if [[ "$FIRST_LINE" =~ ^($type_word(\(|\:|[[:space:]]|$)) ]]; then
        exit 0
    fi
done

if ! echo "$FIRST_LINE" | grep -qE "TASK-[0-9]{3,}"; then
    echo "[FAIL] commit message 必须引用 TASK-XXX 或以豁免前缀开头" >&2
    echo "       当前消息首行：$FIRST_LINE" >&2
    echo "       示例 1：feat(TASK-042): implement edge buffer" >&2
    echo "       示例 2：chore: bump dependency" >&2
    echo "       示例 3：docs: update README" >&2
    echo "       豁免前缀：${EXEMPT_PREFIXES[*]}" >&2
    exit 1
fi

# 受保护路径的 APPROVED-BY 检查（架构师 S7）
# 注：commit-msg 阶段，git staged 变更可查
PROTECTED_PATTERNS=(
    "tests/**"
    "contracts/**"
    ".harness/**"
    ".githooks/**"
    ".github/**"
    "Directory.Build.props"
    "Directory.Build.targets"
    "stryker-config.json"
)

STAGED_FILES=$(git diff --cached --name-only)

PROTECTED_HIT=""
for f in $STAGED_FILES; do
    for pattern in "${PROTECTED_PATTERNS[@]}"; do
        case "$f" in
            $pattern)
                PROTECTED_HIT="$PROTECTED_HIT $f"
                ;;
        esac
    done
done

if [ -n "$PROTECTED_HIT" ]; then
    if ! echo "$COMMIT_MSG" | grep -qE "\[APPROVED-BY:[[:space:]]*\S+\]"; then
        echo "[FAIL] 触碰受保护路径，必须含 [APPROVED-BY: <name>] 标记：" >&2
        for f in $PROTECTED_HIT; do
            echo "  - $f" >&2
        done
        echo "       修复方式：commit message 加 [APPROVED-BY: architect-name]" >&2
        echo "       或豁免前缀：chore:/docs:" >&2
        echo "       或架构师本人设 SKIP_PROTECTED_CHECK=1" >&2
        echo "" >&2
        echo "       ⚠  .github/workflows/ 修改需架构师批准（CI 配置不能自改）" >&2
        exit 1
    fi
fi

exit 0
