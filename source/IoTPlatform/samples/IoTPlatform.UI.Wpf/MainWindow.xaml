<Window x:Class="IoTPlatform.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IoTPlatform - 采集平台示例" Height="600" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="IoTPlatform WPF 示例骨架"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 AcceptsReturn="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="启动所有采集器（Mock）" Click="OnStartMock" Margin="0,0,8,0" Padding="12,4"/>
            <Button Content="停止" Click="OnStop" Margin="0,0,8,0" Padding="12,4"/>
            <TextBlock x:Name="StatusText" Text="状态: 待启动" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
