#!/bin/bash
# 重量门禁：推送前必须全部通过
# 架构师 §一 方案 1（pre-push hook）
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# shellcheck disable=SC1091
source .githooks/lib/common.sh

echo "=== pre-push gate ==="

# 0. 分支规则（isolation-revision F7：直推主干与强推一律拒绝；
#    去污用“删分支重建”替代强推）
#    feat/*|fix/* 普通推送不受影响，仅做非阻断提示。
remote="$1"  # pre-push hook arg 1: remote name (origin)
if [ "$remote" = "origin" ]; then
    while read local_ref local_sha remote_ref remote_sha; do
        branch="${remote_ref#refs/heads/}"
        case "$branch" in
            main|develop|master)
                fail "direct push to $branch denied (iron law 13): open a PR instead"
                ;;
            feat/*|fix/*)
                info "pushing to $branch: for task delivery, archive acceptance records to .harness/tasks/ (non-blocking)"
                ;;
        esac
        # 0000… = new branch, always allowed
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                fail "force-push to $branch denied: delete and recreate the branch instead"
            fi
        fi
    done
fi

# 1. 全测试（仓库无 .sln，逐个工程）
for proj in tests/GenCollector.Tests/GenCollector.Tests.csproj tests/GenDashboard.Tests/GenDashboard.Tests.csproj tests/ReliabilityTests/ReliabilityTests.csproj; do
    [ -f "$proj" ] || continue
    if [[ "$proj" == *GenCollector* ]]; then
        args=( "$proj" -c Release "-r" "win-x86" "-p:PlatformTarget=x86" --no-build --nologo -v quiet )
    else
        args=( "$proj" -c Release --no-build --nologo -v quiet )
    fi
    dotnet test "${args[@]}" || fail "full test run failed: $proj"
done

# 2. 覆盖率差分（如果存在脚本）
if [ -f "scripts/check-coverage-diff.sh" ]; then
    bash scripts/check-coverage-diff.sh || warn "coverage diff failed (observation period, non-blocking)"
else
    info "coverage-diff script not found, skipping (L2-B partial stage not enabled)"
fi

# 3. 变异测试（如果配置存在）
if [ -f "stryker-config.json" ]; then
    info "mutation testing in observation period, blocking skipped (L2-B stage, break=15)"
else
    info "stryker-config.json not found, skipping mutation testing"
fi

# 4. 可靠性工具链（仅在 Docker daemon 可用时跑）
if command -v docker > /dev/null 2>&1 && docker info > /dev/null 2>&1; then
    info "Docker daemon detected, running reliability toolchain"
    dotnet test tests/ReliabilityTests/ReliabilityTests.csproj -c Release --no-build --nologo -v quiet \
        || warn "reliability toolchain failed (observation period)"
else
    info "no Docker daemon locally, skipping ReliabilityTests (architect sec.5 permits downgrade)"
fi

ok "pre-push all passed"
