#!/bin/bash
# Force commit message to reference TASK-XXX (architect §1 S4)
# TASK-023: E1 removed — no exempt prefixes/types; protection is pure path
#   judgment: first line must reference TASK-XXX; protected-path hits are
#   judged by check_approval.py (active card allow_write + non-empty approver).
# TASK-024 C3: all hook output is ASCII (AGENTS rule 4). No change to
#   authorization semantics, SKIP boundary, or exit codes.
set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

FIRST_LINE="$(echo "$COMMIT_MSG" | head -n 1)"

# TASK-XXX reference check (no exemption since TASK-023: conventional
# prefixes like chore:/docs:/feat: no longer bypass this gate)
if ! echo "$FIRST_LINE" | grep -qE "TASK-[0-9]{3,}"; then
    echo "[FAIL] commit message must reference TASK-XXX" >&2
    echo "       current first line: $FIRST_LINE" >&2
    echo "       example: TASK-042 feat: implement edge buffer" >&2
    echo "       (since TASK-023: E1 prefix exemption removed)" >&2
    exit 1
fi

# Architect channel: skips the protected-path gate only, never the TASK reference
if [ "${SKIP_PROTECTED_CHECK:-0}" = "1" ]; then
    exit 0
fi

# Protected-path approval check (architect S7; prose authorization void,
# sole basis: check_approval.py — active card allow_write + non-empty approver).
# Note: at commit-msg stage, git staged changes are inspectable.
# TASK-048: engine resolved via git-common-dir main-tree anchor (ADR-006) so
# worktree commits judge against live main-tree cards, not branch snapshots.
# Note: bash side does NOT recompute PROTECTED_HIT; the authoritative
# judgment is python-side check_approval.py (single engine, no fork).
PYTHON="$(command -v python3 || command -v python)"
_GITCOMMON="$(git rev-parse --git-common-dir)"
_MAINROOT="$(cd "$_GITCOMMON/.." && pwd)"
if ! "$PYTHON" "$_MAINROOT/docs/ai-workspace/hooks/check_approval.py" --staged; then
    echo "[FAIL] protected path touched without covering active card (non-empty approver field)" >&2
    echo "       fix: find the active card covering this file and have the architect fill its approver field" >&2
    echo "       or the architect sets SKIP_PROTECTED_CHECK=1" >&2
    echo "" >&2
    echo "       !  .github/workflows/ changes require architect approval (CI config is not self-modifiable)" >&2
    exit 1
fi

exit 0
